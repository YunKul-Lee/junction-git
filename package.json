{
  "name": "junction",
  "displayName": "Junction for Git",
  "description": "Branch sidebar for Git: browse, switch and manage branches and pull requests.",
  "version": "0.3.0",
  "publisher": "TODO-publisher",
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "junction",
          "title": "%junction.container.title%",
          "icon": "media/junction.svg"
        }
      ]
    },
    "views": {
      "junction": [
        {
          "id": "junction.branches",
          "name": "%junction.view.branches%"
        }
      ]
    },
    "commands": [
      {
        "command": "junction.refresh",
        "title": "%junction.cmd.refresh%",
        "category": "Junction",
        "icon": "$(refresh)"
      },
      {
        "command": "junction.filter",
        "title": "%junction.cmd.filter%",
        "category": "Junction",
        "icon": "$(filter)"
      },
      {
        "command": "junction.clearFilter",
        "title": "%junction.cmd.clearFilter%",
        "category": "Junction",
        "icon": "$(clear-all)"
      },
      {
        "command": "junction.compareWithCurrent",
        "title": "%junction.cmd.compareWithCurrent%",
        "category": "Junction"
      },
      {
        "command": "junction.closeCompare",
        "title": "%junction.cmd.closeCompare%",
        "category": "Junction",
        "icon": "$(close)"
      },
      {
        "command": "junction.copyCommitHash",
        "title": "%junction.cmd.copyCommitHash%",
        "category": "Junction"
      },
      {
        "command": "junction.copyCommitMessage",
        "title": "%junction.cmd.copyCommitMessage%",
        "category": "Junction"
      },
      {
        "command": "junction.checkout",
        "title": "%junction.cmd.checkout%",
        "category": "Junction",
        "icon": "$(arrow-right)"
      },
      {
        "command": "junction.checkoutBranch",
        "title": "%junction.cmd.checkoutBranch%",
        "category": "Junction"
      },
      {
        "command": "junction.newBranch",
        "title": "%junction.cmd.newBranch%",
        "category": "Junction"
      },
      {
        "command": "junction.rename",
        "title": "%junction.cmd.rename%",
        "category": "Junction"
      },
      {
        "command": "junction.delete",
        "title": "%junction.cmd.delete%",
        "category": "Junction"
      },
      {
        "command": "junction.deleteRemote",
        "title": "%junction.cmd.deleteRemote%",
        "category": "Junction"
      },
      {
        "command": "junction.push",
        "title": "%junction.cmd.push%",
        "category": "Junction"
      },
      {
        "command": "junction.pull",
        "title": "%junction.cmd.pull%",
        "category": "Junction"
      },
      {
        "command": "junction.fetch",
        "title": "%junction.cmd.fetch%",
        "category": "Junction",
        "icon": "$(cloud-download)"
      },
      {
        "command": "junction.sync",
        "title": "%junction.cmd.sync%",
        "category": "Junction",
        "icon": "$(sync)"
      },
      {
        "command": "junction.cleanupMerged",
        "title": "%junction.cmd.cleanupMerged%",
        "category": "Junction",
        "icon": "$(trash)"
      },
      {
        "command": "junction.createPr",
        "title": "%junction.cmd.createPr%",
        "category": "Junction"
      },
      {
        "command": "junction.createPrPickTarget",
        "title": "%junction.cmd.createPrPickTarget%",
        "category": "Junction"
      },
      {
        "command": "junction.pullRequest.changeWebUrl",
        "title": "%junction.cmd.changeWebUrl%",
        "category": "Junction"
      },
      {
        "command": "junction.copyBranchName",
        "title": "%junction.cmd.copyBranchName%",
        "category": "Junction"
      },
      {
        "command": "junction.mergeIntoCurrent",
        "title": "%junction.cmd.mergeIntoCurrent%",
        "category": "Junction"
      },
      {
        "command": "junction.rebaseCurrentOnto",
        "title": "%junction.cmd.rebaseCurrentOnto%",
        "category": "Junction"
      },
      {
        "command": "junction.continueOperation",
        "title": "%junction.cmd.continueOperation%",
        "category": "Junction",
        "icon": "$(debug-continue)"
      },
      {
        "command": "junction.abortOperation",
        "title": "%junction.cmd.abortOperation%",
        "category": "Junction",
        "icon": "$(debug-stop)"
      },
      {
        "command": "junction.openConflicts",
        "title": "%junction.cmd.openConflicts%",
        "category": "Junction"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "junction.fetch",
          "when": "view == junction.branches",
          "group": "1_actions@1"
        },
        {
          "command": "junction.filter",
          "when": "view == junction.branches",
          "group": "navigation@1"
        },
        {
          "command": "junction.clearFilter",
          "when": "view == junction.branches && junction.filterActive",
          "group": "navigation@2"
        },
        {
          "command": "junction.sync",
          "when": "view == junction.branches",
          "group": "navigation@3"
        },
        {
          "command": "junction.cleanupMerged",
          "when": "view == junction.branches",
          "group": "navigation@4"
        },
        {
          "command": "junction.refresh",
          "when": "view == junction.branches",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "junction.compareWithCurrent",
          "when": "view == junction.branches && viewItem =~ /^branch-(local|local-merged|remote)$/",
          "group": "1_compare"
        },
        {
          "command": "junction.closeCompare",
          "when": "view == junction.branches && viewItem == compare",
          "group": "inline"
        },
        {
          "command": "junction.copyCommitHash",
          "when": "view == junction.branches && viewItem == commit",
          "group": "9_copy@1"
        },
        {
          "command": "junction.copyCommitMessage",
          "when": "view == junction.branches && viewItem == commit",
          "group": "9_copy@2"
        },
        {
          "command": "junction.checkout",
          "when": "view == junction.branches && viewItem =~ /^branch-(local|local-merged)$/",
          "group": "inline@1"
        },
        {
          "command": "junction.checkout",
          "when": "view == junction.branches && viewItem =~ /^branch-(local|local-merged|remote)$/",
          "group": "0_switch@1"
        },
        {
          "command": "junction.newBranch",
          "when": "view == junction.branches && viewItem =~ /^branch-(local(-head|-merged)?|remote)$/",
          "group": "0_switch@2"
        },
        {
          "command": "junction.push",
          "when": "view == junction.branches && viewItem =~ /^branch-local(-head|-merged)?$/",
          "group": "2_sync@1"
        },
        {
          "command": "junction.pull",
          "when": "view == junction.branches && viewItem =~ /^branch-local(-head|-merged)?$/",
          "group": "2_sync@2"
        },
        {
          "command": "junction.rename",
          "when": "view == junction.branches && viewItem =~ /^branch-local(-head|-merged)?$/",
          "group": "3_manage@1"
        },
        {
          "command": "junction.delete",
          "when": "view == junction.branches && viewItem =~ /^branch-local(-head|-merged)?$/",
          "group": "3_manage@2"
        },
        {
          "command": "junction.deleteRemote",
          "when": "view == junction.branches && viewItem == branch-remote",
          "group": "3_manage@3"
        },
        {
          "command": "junction.createPr",
          "when": "view == junction.branches && junction.hasPullRequest && viewItem =~ /^branch-local(-head|-merged)?$/",
          "group": "2_sync@3"
        },
        {
          "command": "junction.createPrPickTarget",
          "when": "view == junction.branches && junction.hasPullRequest && viewItem =~ /^branch-local(-head|-merged)?$/",
          "group": "2_sync@4"
        },
        {
          "command": "junction.copyBranchName",
          "when": "view == junction.branches && viewItem =~ /^branch-(local(-head|-merged)?|remote)$/",
          "group": "9_copy@0"
        },
        {
          "command": "junction.mergeIntoCurrent",
          "when": "view == junction.branches && viewItem =~ /^branch-(local|local-merged|remote)$/",
          "group": "1_merge@1"
        },
        {
          "command": "junction.rebaseCurrentOnto",
          "when": "view == junction.branches && viewItem =~ /^branch-(local|local-merged|remote)$/",
          "group": "1_merge@2"
        },
        {
          "command": "junction.continueOperation",
          "when": "view == junction.branches && viewItem == status-rebase",
          "group": "inline@1"
        },
        {
          "command": "junction.abortOperation",
          "when": "view == junction.branches && viewItem =~ /^status-(rebase|merge)$/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "junction.compareWithCurrent",
          "when": "false"
        },
        {
          "command": "junction.closeCompare",
          "when": "false"
        },
        {
          "command": "junction.copyCommitHash",
          "when": "false"
        },
        {
          "command": "junction.copyCommitMessage",
          "when": "false"
        },
        {
          "command": "junction.clearFilter",
          "when": "junction.filterActive"
        },
        {
          "command": "junction.checkout",
          "when": "false"
        },
        {
          "command": "junction.newBranch",
          "when": "false"
        },
        {
          "command": "junction.rename",
          "when": "false"
        },
        {
          "command": "junction.delete",
          "when": "false"
        },
        {
          "command": "junction.deleteRemote",
          "when": "false"
        },
        {
          "command": "junction.push",
          "when": "false"
        },
        {
          "command": "junction.pull",
          "when": "false"
        },
        {
          "command": "junction.createPr",
          "when": "false"
        },
        {
          "command": "junction.createPrPickTarget",
          "when": "false"
        },
        {
          "command": "junction.copyBranchName",
          "when": "false"
        },
        {
          "command": "junction.mergeIntoCurrent",
          "when": "false"
        },
        {
          "command": "junction.rebaseCurrentOnto",
          "when": "false"
        },
        {
          "command": "junction.continueOperation",
          "when": "false"
        },
        {
          "command": "junction.abortOperation",
          "when": "false"
        },
        {
          "command": "junction.openConflicts",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%junction.config.title%",
      "properties": {
        "junction.baseBranch": {
          "type": "string",
          "default": "",
          "description": "%junction.config.baseBranch%"
        },
        "junction.branchSort": {
          "type": "string",
          "enum": [
            "recent",
            "name"
          ],
          "default": "recent",
          "description": "%junction.config.branchSort%"
        },
        "junction.groupByFolder": {
          "type": "boolean",
          "default": true,
          "description": "%junction.config.groupByFolder%"
        },
        "junction.commitLimit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "%junction.config.commitLimit%"
        },
        "junction.confirmMerge": {
          "type": "boolean",
          "default": true,
          "description": "%junction.config.confirmMerge%"
        },
        "junction.pullRequest.servers": {
          "type": "array",
          "default": [],
          "description": "%junction.config.pullRequestServers%",
          "items": {
            "type": "object",
            "required": [
              "gitHost",
              "type"
            ],
            "properties": {
              "gitHost": {
                "type": "string"
              },
              "webUrl": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "bitbucket-cloud",
                  "bitbucket-datacenter",
                  "github",
                  "gitlab",
                  "none"
                ]
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile:test": "tsc -p tsconfig.test.json",
    "test:unit": "vitest run",
    "test:ext": "npm run build && npm run compile:test && vscode-test --label stable",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "npm run typecheck && eslint src test --ext ts",
    "package": "vsce package",
    "test:ext:min": "npm run build && npm run compile:test && vscode-test --label min"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "@types/vscode": "1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
